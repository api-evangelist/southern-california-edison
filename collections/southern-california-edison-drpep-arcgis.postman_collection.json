            "name": "Get a feature layer or table descriptor",
            "description": {
              "content": "Returns the layer descriptor including the full field list (name, Esri type, alias), geometry type, drawing info, `maxRecordCount`, and `advancedQueryCapabilities` (pagination, statistics, order-by, distinct are all supported on these layers). The field list is the only field-level documentation SCE provides for DRPEP data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "arcgis_server",
                "rest",
                "services",
