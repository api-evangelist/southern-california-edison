    {
      "id": "18f32bc4-86ff-412c-8704-4d2b657aca79",
      "name": "Query",
      "description": {
        "content": "Attribute and spatial queries against a feature layer or table.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "037066ac-2cc5-4c0c-aa25-5df27b9fc57e",
          "name": "Query features from a layer or table",
          "request": {
            "name": "Query features from a layer or table",
            "description": {
              "content": "The workhorse operation. Runs a SQL-92 attribute filter and/or a spatial filter against one layer and returns matching features as Esri JSON (`f=json`) or GeoJSON (`f=geojson`, verified working). Paging is offset-based via `resultOffset` + `resultRecordCount`; when a response is truncated the body carries `exceededTransferLimit: true` and the caller must page. Errors are returned with HTTP 200 and an `error` envelope, not an HTTP error status.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "arcgis_server",
                "rest",
                "services",
                "Hosted",
                ":serviceName",
                "FeatureServer",
                ":layerId",
                "query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "where",
                  "value": "1=1",
                  "description": "SQL-92 WHERE clause applied to the layer attributes. Use `1=1` to select everything. A malformed clause returns HTTP 200 with an ArcGIS error envelope (code 500, 'Syntax error')."
                },
                {
                  "disabled": false,
                  "key": "objectIds",
                  "value": "<string>",
                  "description": "Comma-separated list of ObjectIDs to fetch instead of a where clause."
                },
                {
                  "disabled": false,
                  "key": "geometry",
                  "value": "<string>",
                  "description": "Geometry used to spatially filter the layer, in the format implied by geometryType (e.g. an envelope `xmin,ymin,xmax,ymax`)."
                },
                {
                  "disabled": false,
                  "key": "geometryType",
                  "value": "<string>",
                  "description": "Type of the geometry filter."
                },
                {
                  "disabled": false,
                  "key": "spatialRel",
                  "value": "esriSpatialRelIntersects",
                  "description": "Spatial relationship applied between the input geometry and the layer geometry."
                },
                {
                  "disabled": false,
                  "key": "inSR",
                  "value": "<string>",
                  "description": "Spatial reference of the input geometry (WKID)."
                },
                {
                  "disabled": false,
                  "key": "outSR",
                  "value": "<string>",
                  "description": "Spatial reference the returned geometry is projected into (WKID)."
                },
                {
                  "disabled": false,
                  "key": "outFields",
                  "value": "*",
                  "description": "Comma-separated attribute list to return, or `*` for all. Field names come from the layer descriptor."
                },
                {
                  "disabled": false,
                  "key": "returnGeometry",
                  "value": "true",
                  "description": "Whether to include geometry with each feature. Set false for attribute-only pulls."
                },
                {
                  "disabled": false,
                  "key": "returnCountOnly",
                  "value": "false",
                  "description": "Return only the matching feature count. Verified: `where=1=1&returnCountOnly=true` on ICA - Circuit Segments returned 676,467."
                },
                {
                  "disabled": false,
                  "key": "returnIdsOnly",
                  "value": "false",
                  "description": "Return only the matching ObjectIDs - the standard way to page a layer larger than maxRecordCount."
                },
                {
                  "disabled": false,
                  "key": "orderByFields",
                  "value": "<string>",
                  "description": "Comma-separated ORDER BY expression. Supported (supportsOrderBy is true on these layers)."
                },
                {
                  "disabled": false,
                  "key": "groupByFieldsForStatistics",
                  "value": "<string>",
                  "description": "Fields to group by when computing outStatistics."
                },
                {
                  "disabled": false,
                  "key": "outStatistics",
                  "value": "<string>",
                  "description": "JSON array of statistic definitions (count/sum/min/max/avg/stddev). Supported (supportsStatistics is true)."
                },
                {
                  "disabled": false,
                  "key": "resultOffset",
                  "value": "<integer>",
                  "description": "Zero-based offset for pagination. Supported (supportsPagination is true)."
                },
                {
                  "disabled": false,
                  "key": "resultRecordCount",
                  "value": "<integer>",
                  "description": "Maximum number of features to return in this page; capped by the layer maxRecordCount (2,000 or 5,000 on these services)."
                },
                {
                  "disabled": false,
                  "key": "returnDistinctValues",
                  "value": "false",
                  "description": "Return distinct values for the requested outFields (supportsDistinct is true)."
                },
                {
                  "disabled": false,
                  "key": "resultType",
                  "value": "<string>",
                  "description": "Query result hint."
                },
                {
                  "disabled": false,
                  "key": "f",
                  "value": "html",
                  "description": "Response format. `json` (Esri JSON), `pjson` (pretty JSON), `geojson` (GeoJSON - verified supported on hosted feature layers), or `html` (the default ArcGIS REST Services Directory page). Always send `f=json` for machine use; without it the service returns HTML."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "serviceName",
                  "description": "(Required) Name of a hosted feature service, as returned by `listHostedServices`."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "layerId",
                  "description": "(Required) Zero-based id of a layer or table inside the feature service, as returned by `getFeatureService`. See `x-drpep-inventory` in this document for the full 58-entry layer/table map."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "8f1be520-6a27-4799-9a24-a2732363fece",
              "name": "A feature set, a count, an id list, or an ArcGIS error envelope - all with HTTP 200.",
              "originalRequest": {
                "url": {
                  "path": [
                    "arcgis_server",
                    "rest",
                    "services",
                    "Hosted",
                    ":serviceName",
                    "FeatureServer",
                    ":layerId",
                    "query"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "where",
                      "value": "circuit_name = 'Acapulco'"
                    },
                    {
                      "key": "objectIds",
                      "value": "<string>"
                    },
                    {
                      "key": "geometry",
                      "value": "<string>"
                    },
                    {
                      "key": "geometryType",
                      "value": "<string>"
                    },
                    {
                      "key": "spatialRel",
                      "value": "esriSpatialRelIntersects"
                    },
                    {
                      "key": "inSR",
                      "value": "4326"
                    },
                    {
                      "key": "outSR",
                      "value": "4326"
                    },
                    {
                      "key": "outFields",
                      "value": "circuit_name,ica_overall_pv"
                    },
                    {
                      "key": "returnGeometry",
                      "value": "true"
                    },
                    {
                      "key": "returnCountOnly",
                      "value": "false"
                    },
                    {
                      "key": "returnIdsOnly",
                      "value": "false"
                    },
